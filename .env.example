# Copy to .env and fill in. Names only - never commit real values (this repo is public).

# --- Server ---
PORT=3002
NODE_ENV=development
API_URL=http://localhost:3002
APP_URL=http://localhost:3000
# Extra allowed CORS origin (optional)
CLIENT_URL=

# Postgres (required - server/db.js)
DATABASE_URL=

# Google OAuth (required - the server crashes on startup without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs login tokens; required in production
SESSION_SECRET=

# Google service account, as a single-line JSON string (Drive / Modeling).
# Alternatively place service-account.json in the repo root (gitignored).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Drive folder IDs (optional - code has defaults)
PROJECTS_DRIVE_FOLDER_ID=
MODELING_ROOT_FOLDER_ID=
MODELING_TEMPLATES_FOLDER_ID=
MODELING_PROJECTS_FOLDER_ID=

# Email via Resend (optional - reminders / design notifications)
RESEND_API_KEY=

# Debug: log every SQL query (optional)
DEBUG_SQL=

# Legacy Google Sheets setup/migration scripts only (not the running app)
ORIGINATION_SHEET_ID=
# server/update-colors.js only
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Set automatically by Railway - don't set locally
# RAILWAY_ENVIRONMENT=
# RAILWAY_ENVIRONMENT_NAME=
# RAILWAY_GIT_COMMIT_SHA=

# --- Client (put these in client/.env) ---
# REACT_APP_API_URL=http://localhost:3002
# REACT_APP_WS_URL=            # optional, defaults to REACT_APP_API_URL
# REACT_APP_COMMIT_SHA=        # set by the build script
